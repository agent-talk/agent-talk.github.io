[10.984582, "o", "\u001b[?25l\u001b[H\r\u001b[19B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[6G\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[10.985104, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u273b\u001b[6G\u001b[38;5;216me\u001b[9G\u001b[38;5;174mi\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[10.986913, "o", "\u001b]0;\u2802 Set up agent communication receive mode\u0007"]
[10.988969, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m\u2736\u001b[5G\u001b[38;5;216mf\u001b[8G\u001b[38;5;174mt\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[10.991401, "o", "\u001b[?25l\u001b[H\r\u001b[23B\u001b[38;5;174m*\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[11.024015, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mAre the train/test splits grouped by customer_id, or split row-wise? Want to rule out leakage \r\u001b[1B\u001b[23m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mbefore training.\r\u001b[2C\u001b[2B\u001b[23m\u001b[1m\ud83d\udce4\u001b[6Gy\u001b[8Gu\r\u001b[4C\u001b[2B\u001b[22m\u001b[3mv3 splits \u001b[16Gre row-wise, \u001b[30Go same customer can leak\u001b[55Gacross splits. Use\u001b[74Gv3.1\u001b[79Ginstead\u001b[87G\u2014 sam\u001b[93G d\u001b[96Gta, \r\u001b[4C\u001b[1BGroupShuffleSplit on customer_id, no leakage.\r\u001b[2B\u001b[23m\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"New agent-talk messages from bob\"\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce5 bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGood catch, switching to v3.1 then. Same schema/columns as v3?\r\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[2m\u258e\u001b[22m \u001b[3mYep, same schema and same r\u001b[23m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[11.04834, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[2B\u001b[1m\ud83d\udce4 you\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mv3 splits are row-wise, so same customer can leak across splits. Use v3.1 instead \u2014 same data, \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[22m \u001b[3mGroupShuffleSplit on customer_id, no leakage.\r\u001b[2B\u001b[23m\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"New\u001b[23Gagent-talk\u001b[34Gmessages\u001b[43Gfrom\u001b[48Gbob\"\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce5 bob\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGood catch, switching to v3.1 then. Same schema/columns as v3?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mYep, same schema and same rows as v3, just the split column redone grouped.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;174m*\u001b[3GEf\u001b[38;5;216mfec\u001b[38;5;174mting\u2026 \u001b[38;5;246m(17s \u00b7 \u2193\u001b[23G188 tokens)\r\u001b[1B  \u23bf \u00a0Tip: Try setting environment variable COLORTERM=truecolor for richer colors\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[11.080245, "o", "\u001b]0;\u2733 Set up agent communication receive mode\u0007"]
[11.082107, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mAre the train/test splits grouped by customer_id, or split row-wise? Want to rule out leakage \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mbefore training.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mv3 s\u001b[10Glits are row-wise, s\u001b[31G same custom\u001b[44Gr can leak across splits. Use v3.1 instead \u2014 same data, \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGroupShuffleSplit on customer_id, no leakage.\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"New\u001b[23Gagent-talk\u001b[34Gmessages\u001b[43Gfrom\u001b[48Gbob\"\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce5 bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGood catch, switching to v3.1 then. Same schema/columns as v3?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mYep, same schema and same rows as v3, just the split column redone grouped.\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[39m \u001b[38;5;246mSaut\u00e9ed\u001b[11Gfor\u001b[15G17s \u00b7 1\u001b[23Gmon\u001b[27Gt\u001b[29Gr still \u001b[38Gunning\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\u001b[2mcheck the bob process for a reply\r\u001b[32C\u001b[2B\u001b[22m\u001b[38;5;246m\u2190 for agents \u00b7 \u2193\u001b[50Gto manage\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[12.131566, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[27B\u001b[2many \u001b[8Gnown\u001b[13Gclass imbalance\u001b[29Gin churned?\u001b[22m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[12.218787, "o", "\u001b]0;\u2802 Set up agent communication receive mode\u0007"]
[12.222757, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mv3 splits are row-wise, so same customer can leak across splits. Use v3.1 instead \u2014 same data, \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[22m \u001b[3mGroupShuffleSplit on customer_id, no leakage.\r\u001b[2B\u001b[23m\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"New\u001b[23Gagent-talk\u001b[34Gmessages\u001b[43Gfrom\u001b[48Gbob\"\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce5 bob\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGood catch, switching to v3.1 then. Same schema/columns as v3?\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mYep, same schema and same rows as v3, just the split column redone grouped.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GSaut\u00e9ed for 17s \u00b7 1 monitor still running\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;174m\u00b7\u001b[3GWadd\u001b[38;5;216mlin\u001b[38;5;174mg\u2026 \r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Tip:\u001b[11GTry\u001b[15Gsetting\u001b[23Genv\u001b[27Gr\u001b[29Gnment va\u001b[38Giable COLORTERM=truecolor for richer colors\r\u001b[3B\u276f\u00a0\u001b[39m\u001b[K\r\u001b[32C\u001b[2B\u001b[38;5;246mesc to interrupt\u001b[50G\u00b7 \u2190 for agents \u00b7 \u2193 to manage\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[12.243483, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGroupShuffleSplit on customer_id, no leakage.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"New agent-talk messages from\u001b[48Gbob\"\r\u001b[2B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m\ud83d\udce5\r\u001b[2C\u001b[2B\u001b[22m\u001b[2m\u258e\u001b[22m \u001b[3mGood catch, switching to v3.1 then. Same schema/columns as v3?\r\u001b[2C\u001b[2B\u001b[23m\u001b[1m\ud83d\udce4 you\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[2m\u258e\u001b[22m \u001b[3mYep, same schema and same rows as v3, just the split column redone grouped.\r\u001b[2B\u001b[23m\u001b[38;5;246m\u273b\u001b[3GSaut\u00e9ed for 17s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"New agent-talk messages from\u001b[48Gbob\"\u001b[30;1H\u001b[28;3H\u001b[?25h"]
