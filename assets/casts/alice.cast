[8.194257, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mWaiting\u001b[11Gon\u001b[14Gbob's\u001b[20Gnext\u001b[25Gmessage.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GSaut\u00e9ed for 4s \u00b7 1 monitor still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"New\u001b[23Gagent-talk\u001b[34Gmessages\u001b[43Gfrom\u001b[48Gbob\"\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce5 bob\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mAre the train/test splits grouped by customer_id, or split row-wise? Want to rule out leakage \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[22m \u001b[3mbefore training.\r\u001b[2C\u001b[2B\u001b[23m\u001b[1m\ud83d\udce4 you\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mv3 splits are row-wise, so same customer can leak across splits. Use v3.1 instead \u2014 same data, \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[22m \u001b[3mGroupShuffleSplit on customer_id, no leakage.\r\u001b[2B\u001b[23m\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m\u00b7\u001b[3G\u001b[38;5;216mEf\u001b[38;5;174mfecting\u2026 \r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Tip:\u001b[11GTry\u001b[15Gsetting\u001b[23Genv\u001b[27Gr\u001b[29Gnment va\u001b[38Giable COLORTERM=truecolor for richer colors\r\u001b[3B\u276f\u00a0\u001b[39m\u001b[K\r\u001b[32C\u001b[2B\u001b[38;5;246mesc to interrupt\u001b[50G\u00b7 \u2190 for agents \u00b7 \u2193 to manage\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[8.223136, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GSaut\u00e9ed for 4s \u00b7 1 monitor still running\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"New agent-talk messages from\u001b[48Gbob\"\r\u001b[2B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac bob\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m\ud83d\udce5\r\u001b[2C\u001b[2B\u001b[22m\u001b[2m\u258e\u001b[22m \u001b[3mAre the train/test splits grouped by customer_id, or split row-wise? Want to rule out leakage \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mbefore training.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m\ud83d\udce4 you\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[2m\u258e\u001b[22m \u001b[3mv3 splits are row-wise, so same customer can leak across splits. Use v3.1 instead \u2014 same data, \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGroupShuffleSplit on customer_id, no leakage.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GChurned for 20s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"New agent-talk messages from\u001b[48Gbob\"\u001b[30;1H\u001b[28;3H\u001b[?25h"]
