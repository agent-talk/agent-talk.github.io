[10.981991, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[23B\u001b[38;5;174mEffe\u001b[38;5;216mcti\u001b[38;5;174mng\u2026\u001b[16G\u001b[38;5;246m7\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
