[15.426175, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[34C\u001b[6A\u001b[3m main.\r\u001b[2B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce5 frontend\u001b[23m\u001b[22m\u001b[K\r\u001b[1B  \u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGot it, token+expiresIn on success. What does a failed login return \u2014 \r\u001b[1B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[3merror shape/status code?\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce4\u001b[8Gyou\u001b[23m\u001b[22m\r\r\n\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3m401\u001b[9Gwith\u001b[14G{error:\u001b[22G\"invalid_credentials\",\u001b[45Gmessage}.\u001b[55GIf\u001b[58Gthey\u001b[63Gfail\u001b[68G5\u001b[70Gtimes\u001b[23m\r\r\n\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3myou\u001b[9Gget\u001b[13G423\u001b[17G(locked,\u001b[26G15\u001b[29Gmin).\u001b[23m\r\r\n\r\r\n\u001b[38;5;174m\u2722\u001b[3GCalcu\u001b[38;5;216mlat\u001b[38;5;174ming\u2026\u001b[16G\u001b[38;5;246m(7s\u001b[20G\u00b7\u001b[22G\u2193\u001b[24G243\u001b[28Gtokens)\u001b[39m\r\r\n\u001b[38;5;246m \u001b[3G\u23bf\u001b[5G\u00a0Tip:\u001b[11GUse\u001b[15GPlan\u001b[20GMode\u001b[25Gto\u001b[28Gprepare\u001b[36Gfor\u001b[40Ga\u001b[42Gcomplex\u001b[50Grequest\u001b[58Gbefore\u001b[65Gmaking\u001b[39m\r\r\n\u001b[6G\u001b[38;5;246mchanges.\u001b[15GPress\u001b[21Gshift+tab\u001b[31Gtwice\u001b[37Gto\u001b[40Genable.\u001b[39m\r\r\n\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\r\n\u001b[38;5;246m\u276f\