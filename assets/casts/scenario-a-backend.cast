[11.760707, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[2B\u001b[2m\u258e\u001b[22m \u001b[3mSeconds (3600 today). No cookie yet \u2014 store the bearer token yourself \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mfor now; httpOnly cookie is planned next sprint.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GWorked for 11s \u00b7 1 monitor still running\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"New agent-talk messages from\u001b[48Gfrontend\"\r\u001b[2B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac frontend\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[1m\ud83d\udce5 frontend\r\u001b[2B\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mQuick one: is expiresIn on /api/login in seconds or ms? And does login \r\u001b[1B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[3mset a cookie,\u001b[23m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
