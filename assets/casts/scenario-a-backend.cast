[26.392773, "o", "\u001b]0;\u2802 Notify frontend login endpoint is live\u0007"]
[26.426124, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[16C\u001b[6A\u001b[3m ping me if anything looks off once it's wired up.\r\u001b[2B\u001b[23m\u001b[38;5;174m\u00b7\u001b[39m \u001b[38;5;174mPerusin\u001b[38;5;216mg\u2026\u001b[38;5;174m \u001b[38;5;246m(5s \u00b7 \u2193\u001b[39m \u001b[38;5;246m177 tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m  \u23bf \u00a0Tip: Use Plan Mode to prepare for a complex request before making \r\u001b[1B\u001b[39m     \u001b[38;5;246mchanges. Press shift+tab twice to enable.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\r\n\u001b[38;5;246m\u276f\u00a0\u001b[39m\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m\u23f5\u23f5\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m \u00b7\u001b[21G\u001b[38;5;44m1\u001b[23Gmonitor\u001b[38;5;246m \u00b7\u001b[33Gesc\u001b[37Gto\u001b[40Ginterrupt\u001b[50G\u00b7\u001b[52G\u2190\u001b[54Gfor\u001b[58Gagents\u001b[65G\u00b7\u001b[67G\u2193\u001b[69Gto\u001b[72Gma\u2026\u001b[39m\r\r\n\u001b[2C\u001b[3A\u001b[?25h"]
