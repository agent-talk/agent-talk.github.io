[21.176978, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[21C\u001b[6A\u001b[3m or do users just re-login when the token expires?\r\u001b[2B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[1B  \u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mYep, POST /api/refresh \u2014 swap a still-valid token for a fresh one, same \r\u001b[1B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[3mresponse shape as login.\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[38;5;174m\u273b\u001b[3GEffect\u001b[38;5;216ming\u001b[38;5;174m\u2026\u001b[14G\u001b[38;5;246m(6s\u001b[18G\u00b7\u001b[20G\u2193\u001b[22G219\u001b[26Gtokens)\u001b[39m\r\r\n\u001b[38;5;246m \u001b[3G\u23bf\u001b[5G\u00a0Tip:\u001b[11GUse\u001b[15GPlan\u001b[20GMode\u001b[25Gto\u001b[28Gprepare\u001b[36Gfor\u001b[40Ga\u001b[42Gcomplex\u001b[50Grequest\u001b[58Gbefore\u001b[65Gmaking\u001b[39m\r\r\n\u001b[6G\u001b[38;5;246mchanges.\u001b[15GPress\u001b[21Gshift+tab\u001b[31Gtwice\u001b[37Gto\u001b[40Genable.\u001b[39m\r\r\n\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\r\n\u001b[38;5;246m\u276f\u00a0\u001b[39m\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500