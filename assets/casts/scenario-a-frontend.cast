 to create/manage\r\u001b[32C\u001b[1Bsubagents, or edit .claude/agents/\u001b[39m\u001b[22;1H\u001b[20;4H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[3C\u001b[19Bc\u001b[22;1H\u001b[20;5H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[2C\u001b[13B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;153m/cd                           Move this session to a new working\u001b[39m\u001b[K\r\u001b[32C\u001b[1B\u001b[38;5;153mdirectory\r\u001b[3C\u001b[1Bc\u001b[38;5;246mopy  \u001b[33G\u001b[38;5;153mC\u001b[38;5;246mopy Claude's\u001b[47Glast respons\u001b[60G \u001b[62Go clipboard\r\u001b[32C\u001b[1B(or /\u001b[38;5;153mc\u001b[38;5;246mopy N for the Nth-latest)\u001b[39m\u001b[K\u001b[22;1H\u001b[20;5H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[4C\u001b[19Bl\u001b[22;1H\u001b[20;6H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[4C\u001b[14B\u001b[38;5;153mlear\u001b[33GStart a new \u001b[46Gession with empty context;\r\u001b[32C\u001b[1Bprevious session stays on disk (resumable\u2026\r\u001b[4C\u001b[1Bl\u001b[38;5;246maude-api\u001b[33GReference for\u001b[47Gthe \u001b[38;5;153mCl\u001b[38;5;246maude API /\u001b[64GAnthr\u001b[70Gpic\r\u001b[32C\u001b[1BSDK\u001b[37G\u2014 model\u001b[45Gids, pricing, params, streami\u2026\u001b[39m\u001b[22;1H\u001b[20;6H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[5C\u001b[19Be\u001b[22;1H\u001b[20;7H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[3C\u001b[16B\u001b[38;5;246mcode-review\u001b[35Gview the current diff for correctness\u001b[39m\u001b[K\r\u001b[32C\u001b[1B\u001b[38;5;246mbugs and reuse/simplification/efficiency \u001b[39m\u001b[22;1H\u001b[20;7H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[6C\u001b[19Ba\u001b[22;1H\u001b[20;8H\u001b[?25h\u001b[?25l\u001b[H\r\u001b[2C\u001b[13B\u001b[38;5;153m/clear                        Start a new session with empty context;\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;5;153mprevious ses\u001b[46Gion stays on disk\u001b[64G(resumable\u2026\r\u001b[2C\u001b[1B\u001b[38;5;246m/\u001b[38;5;153mcl\u001b[38;5;246maud\u001b[3