[22.387991, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[34C\u001b[6A\u001b[3m main.\r\u001b[2B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[1B  \u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mGot it, token+expiresIn on success. What does a failed login return \u2014 \r\u001b[1B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[3merror shape/status code?\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5\u001b[8Gbackend\u001b[23m\u001b[22m\r\r\n\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3m401\u001b[9Gwith\u001b[14G{error:\u001b[22G\"invalid_\u001b[23m\r\r\n\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\r\n\u001b[38;5;246m\u276f\u00a0\u001b[39m\r\r\n\u001b[38;5;244m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39m\r\r\n\u001b[3G\u001b[38;5;220m\u23f5\u23f5\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;5;246m \u00b7\u001b[21G\u001b[38;5;44m1\u001b[23Gmonitor\u001b[38;5;246m \u00b7\u001b[33Gesc\u001b[37Gto\u001b[40Ginterrupt\u001b[50G\u00b7\u001b[52G\u2190\u001b[54Gfor\u001b[58Gagents\u001b[65