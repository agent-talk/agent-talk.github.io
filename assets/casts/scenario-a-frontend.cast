[29.867002, "o", "\u001b[?25l\u001b[H\u001b[5G\u001b[3mSeco\u001b[10Gds (3600 today). No\u001b[30Gcookie y\u001b[39Gt\u001b[41G\u2014 s\u001b[45Gore the bearer token yourself \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mfor now; httpOnly cookie is planned next sprint.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mGot it. What do\u001b[22G a failed login return \u2014 erro\u001b[52G shape/status code? And \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mis there a refresh endpoint, or do users just re-login on expiry?\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GBrewed for 6s \u00b7 1 monitor still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"agent-talk\u001b[30Ginbox\u001b[36Gwake\u001b[41Gwatch\u001b[47Gfor\u001b[51Gfrontend\"\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRan \u001b[1m1\u001b[22m she\u001b[13Gl\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[6G\u001b[39m\u001b[K\r\u001b[14C\u001b[2B\u001b[38;5;246m7\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[29.876829, "o", "\u001b[?25l\u001b[H\r\u001b[15B\u001b[38;5;174m\u2722\u001b[4Gr\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
