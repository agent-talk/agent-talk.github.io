[39.873895, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mThanks. Quick one \u2014 will the backfill UPDATE lock the orders table for \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mlong?\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GBrewed for 6s \u00b7 2 monitors still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"wake\u001b[24Gon\u001b[27Gincoming\u001b[36Gagent-talk\u001b[47Gmessages\u001b[56Gto\u001b[59Gcarol\"\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;5;246mRan \u001b[1m1\u001b[22m she\u001b[13Gl\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"carol inbox wake watch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gdave\"\r\u001b[2C\u001b[2B\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.037183, "o", "\u001b[?25l\u001b[H\r\u001b[17C\u001b[15B\u001b[38;5;246m8\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.115591, "o", "\u001b[?25l\u001b[H\r\u001b[15B\u001b[38;5;174m\u273b\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.131344, "o", "\u001b[?25l\u001b[H\r\u001b[4C\u001b[1B\u001b[3mThanks. Quick one \u2014 will the backfill UPDATE lock the orders table for \r\u001b[4C\u001b[1Blong?\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GBrewed for 6s \u00b7 2 monitors still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"wake\u001b[24Gon\u001b[27Gincoming\u001b[36Gagent-talk\u001b[47Gmessages\u001b[56Gto\u001b[59Gcarol\"\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"carol\u001b[25Ginbox\u001b[31Gwake\u001b[36Gwatch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gdave\"\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac dave\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 dave\r\u001b[1B\u001b[23m\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mIt's single-pass over all rows (no batching), so on prod's ~800k orders \r\u001b[1B\u001b[23m  \u001b[2m\u258e\u001b[22m \u001b[3mit'll hold row loc\u001b[23m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.312503, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.382999, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"wake\u001b[24Gon\u001b[27Gincoming\u001b[36Gagent-talk\u001b[47Gmessages\u001b[56Gto\u001b[59Gcarol\"\r\u001b[2B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[18C\u001b[2Bc\u001b[21Grol inbox wake\u001b[36Gwatch for mes\u001b[50Gages fr\u001b[58Gm dave\r\u001b[2B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac dave\u001b[22m\u001b[K\r\u001b[2B \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[1m\u001b[3m\ud83d\udce5 dave\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mIt's single-pass over all rows (no batching), so on prod's ~800k orders \r\u001b[1B\u001b[23m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mit'll hold row locks for the whole UPDATE until commit \u2014 could be \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mseconds to tens of seconds, not instant. README's fine with single-pass \r\u001b[4C\u001b[1Bas long as it's fast; this one's simple enough it should be.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[3m**\u001b[23m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.4601, "o", "\u001b]0;\u2802 Review order index migration before merge\u0007"]
[40.476665, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"carol\u001b[25Ginbox\u001b[31Gwake\u001b[36Gwatch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gdave\"\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac dave\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 dave\r\u001b[1B\u001b[23m\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mIt's single-pass over all rows (no batching), so on prod's ~800k orders \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mit'll hold row locks for the whole UPDATE until commit \u2014 could be \r\u001b[1B\u001b[23m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mseconds to tens of seconds, not instant. README's fine with single-pass \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mas long as it's fast; this one's simple enough it should be.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mGood to know, sh\u001b[22Guld\u001b[26Gbe short enough. Mergi\u001b[49Gg now \u2014 thanks for\u001b[68Gthe \r\u001b[4C\u001b[1Br\u001b[7Gview!\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m\u2722\u001b[3GQuantumizing\u2026 \u001b[38;5;246m(8s \u00b7 \u2193\u001b[25G229 tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /feedback to help us improve!\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[40.497865, "o", "\u001b]0;\u2733 Review order index migration before merge\u0007"]
[40.499133, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"carol\u001b[25Ginbox\u001b[31Gwake\u001b[36Gwatch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gdave\"\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac dave\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce5 dave\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mI\u001b[8Gs single-pass over all rows (no\u001b[40Gbatching), so \u001b[55Gn prod's ~800k orders \r\u001b[4C\u001b[1Bit'll hold\u001b[16Grow l\u001b[22Gck\u001b[25G f\u001b[28Gr the whole UPDATE until commit\u001b[60G\u2014 could be \u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mseconds\u001b[13Gto\u001b[16Gten\u001b[21Gof second\u001b[31G, \u001b[34Got instant. README's\u001b[55Gfine with single-pass \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mas long as it's fast; this one's simple enough it should be.\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce4 you\u001b[23m\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[3mGood to know, should be short enough. Merging now \u2014 thanks for the \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mreview!\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[39m \u001b[38;5;246mCrunched for 8s \u00b7 2 monitors still running\r\u001b[3B\u001b[39m\u276f\u00a0\r\u001b[33C\u001b[2B\u001b[38;5;246m\u2190 for agents \u00b7 \u2193\u001b[51Gto manage\u001b[39m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
