[44.377486, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"wake\u001b[24Gon\u001b[27Gincoming\u001b[36Gagent-talk\u001b[47Gmessages\u001b[56Gto\u001b[59Gcarol\"\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac dave\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1m\u001b[3m\ud83d\udce5 dave\u001b[23m\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mSounds good, np!\r\u001b[1B\u001b[23m\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[3GBaked for 1s \u00b7 2 monitors still running\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor\u001b[11Gevent:\u001b[18G\"carol\u001b[25Ginbox\u001b[31Gwake\u001b[36Gwatch\u001b[42Gfor\u001b[46Gmessages\u001b[55Gfrom\u001b[60Gdave\"\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mExchang\u001b[11G wrapped up \u2014 dave f\u001b[32Gxed and pushed the mis\u001b[55Ging transaction wrap,\r\u001b[2C\u001b[1Bconfirmed\u001b[13Gthe\u001b[17Gbackfill\u001b[26Glock\u001b[31Gis\u001b[34Gbrief,\u001b[41Gand\u001b[45GPR\u001b[48G#482\u001b[53Gis\u001b[56Gready\u001b[62Gto\u001b[65Gmerge.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m\u273b\u001b[39m \u001b[38;5;246mCooked for 1s \u00b7 2 moni\u001b[27Grs still\u001b[36Grunning\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[33C\u001b[2B\u001b[38;5;246m\u2190 for agents \u00b7 \u2193\u001b[51Gto manage\u001b[39m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
