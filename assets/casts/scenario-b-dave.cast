[44.452845, "o", "\u001b[?25l\u001b[H\r\u001b[10B \u001b[3G\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[6G\u001b[39m\u001b[K\u001b[22;1H\u001b[20;3H\u001b[?25h"]
