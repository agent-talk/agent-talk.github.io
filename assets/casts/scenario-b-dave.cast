[44.460854, "o", "\u001b[?25l\u001b[H\r\u001b[14B\u001b[38;5;174m\u2736\u001b[26G\u001b[38;5;246m3\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[44.464745, "o", "\u001b[?25l\u001b[H\r\u001b[14B\u001b[38;5;174m\u273b\u001b[3G\u001b[38;5;216mS\u001b[6G\u001b[38;5;174ml\u001b[26G\u001b[38;5;246m5\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[44.574178, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39mMonitor event: \"wake on incoming agent-talk messages from carol\"\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;231m\u25cf\u001b[3G\u001b[39m\u001b[1m\ud83d\udcac carol\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce5 carol\r\u001b[1B\u001b[23m\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[22m \u001b[3mGood to know, should be short enough. Merging now \u2014 thanks for the \r\u001b[2C\u001b[1B\u001b[23m\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mreview!\r\u001b[2C\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1B\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[1m\u001b[3m\ud83d\udce4 you\r\u001b[1B\u001b[23m\u001b[22m \u001b[3G\u001b[2m\u258e\u001b[5G\u001b[22m\u001b[3mSounds good, np!\u001b[23m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
[44.610163, "o", "\u001b[?25l\u001b[H\r\u001b[14B\u001b[38;5;174m\u273d\u001b[5Gh\u001b[25G\u001b[38;5;246m2\u001b[39m\u001b[22;1H\u001b[20;3H\u001b[?25h"]
